<Window x:Class="FFCleaner.Desktop.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Actualizando FFCleaner" Icon="Assets/ffcleaner.ico" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Style="{StaticResource {x:Type Window}}" AutomationProperties.AutomationId="UpdateWindow">
 <!-- Aparece antes de la ventana principal solo cuando hay una versión nueva: descarga, comprueba e instala. -->
 <StackPanel>
  <Border Padding="24,18" Background="{DynamicResource SidebarGradient}">
   <DockPanel>
    <Image DockPanel.Dock="Left" Source="Assets/ffcleaner.png" Width="44" Height="44" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality"/>
    <StackPanel VerticalAlignment="Center">
     <TextBlock x:Name="TitleText" AutomationProperties.AutomationId="UpdateTitle" Foreground="White" FontSize="18" FontWeight="Bold"/>
     <TextBlock x:Name="VersionText" Foreground="#A3ABCC" Margin="0,2,0,0"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <StackPanel Margin="24,18,24,10">
   <ProgressBar x:Name="Bar" Minimum="0" Maximum="100" IsIndeterminate="True"/>
   <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="UpdateStatusText" Foreground="{DynamicResource InkSoft}" TextWrapping="Wrap" Margin="0,10,0,0"/>
  </StackPanel>
  <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,12">
   <Button x:Name="SkipButton" AutomationProperties.AutomationId="SkipUpdateButton" HorizontalAlignment="Right" Margin="0" Click="Skip_Click"/>
  </Border>
 </StackPanel>
</Window>
