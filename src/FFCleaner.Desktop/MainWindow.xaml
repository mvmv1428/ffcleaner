<Window x:Class="FFCleaner.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FFCleaner.Desktop"
        Title="FFCleaner" Icon="Assets/ffcleaner.ico" Width="1400" Height="900" MinWidth="1180" MinHeight="760" WindowStartupLocation="CenterScreen"
        Style="{StaticResource {x:Type Window}}">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="Visible"/>
  <Style x:Key="CellTip" TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="MutedCell" TargetType="TextBlock" BasedOn="{StaticResource CellTip}"><Setter Property="Foreground" Value="{DynamicResource InkSoft}"/></Style>
  <Style x:Key="PageTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="28"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
  <Style x:Key="PageSubtitle" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource InkSoft}"/><Setter Property="Margin" Value="0,6,0,0"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="IconBadge" TargetType="Border"><Setter Property="Width" Value="42"/><Setter Property="Height" Value="42"/><Setter Property="CornerRadius" Value="13"/><Setter Property="Background" Value="{DynamicResource AccentGradient}"/><Setter Property="VerticalAlignment" Value="Top"/></Style>
  <Style x:Key="BadgeGlyph" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource Icons}"/><Setter Property="FontSize" Value="18"/><Setter Property="Foreground" Value="White"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="StatValue" TargetType="TextBlock"><Setter Property="FontSize" Value="26"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Margin" Value="0,2,0,0"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
  <Style x:Key="StatHint" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource InkMuted}"/><Setter Property="FontSize" Value="11.5"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="SectionGlyph" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource Icons}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
  <Style x:Key="Chip" TargetType="Border"><Setter Property="CornerRadius" Value="9"/><Setter Property="Padding" Value="9,3"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Background" Value="{DynamicResource ChipFill}"/></Style>
  <Style x:Key="ChipText" TargetType="TextBlock"><Setter Property="FontSize" Value="11.5"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource InkSoft}"/></Style>

  <!-- Elección entre opciones (tema, idioma): tarjeta con marca, como las familias del Registro. -->
  <Style x:Key="Choice" TargetType="RadioButton">
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Margin" Value="0,0,10,0"/>
   <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="RadioButton">
      <Border x:Name="Card" CornerRadius="12" BorderThickness="1.5" BorderBrush="{DynamicResource Line}" Background="{DynamicResource Surface}" Padding="14,10" MinWidth="150">
       <DockPanel>
        <Border x:Name="Mark" DockPanel.Dock="Right" Width="20" Height="20" CornerRadius="10" BorderThickness="1.5" BorderBrush="{DynamicResource LineStrong}" VerticalAlignment="Center" Margin="12,0,0,0">
         <Ellipse x:Name="Dot" Width="8" Height="8" Fill="White" Visibility="Collapsed"/>
        </Border>
        <StackPanel Orientation="Horizontal">
         <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource Icons}" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource Accent}"/>
         <ContentPresenter VerticalAlignment="Center"/>
        </StackPanel>
       </DockPanel>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentLine}"/></Trigger>
       <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}"/>
        <Setter TargetName="Card" Property="Background" Value="{DynamicResource AccentSoft}"/>
        <Setter TargetName="Mark" Property="Background" Value="{DynamicResource AccentGradient}"/>
        <Setter TargetName="Mark" Property="BorderThickness" Value="0"/>
        <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <!-- Lista de aplicaciones: fila seleccionable con su casilla. -->
  <Style x:Key="AppItem" TargetType="ListBoxItem">
   <Setter Property="AutomationProperties.AutomationId" Value="{Binding ItemAutomationId}"/>
   <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Margin" Value="0,1"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ListBoxItem">
      <Border x:Name="Bd" CornerRadius="10" Padding="10,7" Background="Transparent">
       <Grid>
        <Border x:Name="Bar" Width="3" CornerRadius="2" HorizontalAlignment="Left" Margin="-10,2,0,2" Background="{DynamicResource AccentGradient}" Visibility="Collapsed"/>
        <ContentPresenter/>
       </Grid>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverFill}"/></Trigger>
       <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}"/><Setter TargetName="Bar" Property="Visibility" Value="Visible"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <!-- Casilla en forma de píldora para los perfiles de una categoría. -->
  <Style x:Key="ProfileChip" TargetType="CheckBox">
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Foreground" Value="{DynamicResource InkSoft}"/>
   <Setter Property="Margin" Value="0,6,6,0"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="CheckBox">
      <Border x:Name="Pill" CornerRadius="13" BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="{DynamicResource SurfaceAlt}" Padding="9,4,11,4">
       <StackPanel Orientation="Horizontal">
        <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource InkMuted}"/>
        <ContentPresenter VerticalAlignment="Center" TextElement.FontSize="11.5"/>
       </StackPanel>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource AccentLine}"/></Trigger>
       <Trigger Property="IsChecked" Value="False"><Setter TargetName="Tick" Property="Opacity" Value="0.25"/></Trigger>
       <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="Pill" Property="Background" Value="{DynamicResource AccentSoft}"/>
        <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource Accent}"/>
        <Setter TargetName="Tick" Property="Foreground" Value="{DynamicResource Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>

 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="248"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

  <!-- ═════════════ Barra lateral ═════════════ -->
  <Border Background="{DynamicResource SidebarGradient}">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="24,30,20,34">
     <Image Source="Assets/ffcleaner.png" Width="46" Height="46" RenderOptions.BitmapScalingMode="HighQuality"/>
     <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
      <TextBlock Text="FFCleaner" Foreground="White" FontSize="21" FontWeight="Bold"/>
      <TextBlock Text="{DynamicResource S.Tagline}" Foreground="#9AA3C7" FontSize="11" Margin="1,2,0,0"/>
     </StackPanel>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Margin="18,18,18,22">
     <Border CornerRadius="12" Background="#16FFFFFF" Padding="12,10">
      <DockPanel>
       <TextBlock DockPanel.Dock="Left" Text="&#xEA18;" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="#5EEAD4" VerticalAlignment="Center" Margin="0,0,10,0"/>
       <TextBlock x:Name="ModeText" AutomationProperties.AutomationId="ModeText" Foreground="#D6E9F2" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
      </DockPanel>
     </Border>
     <TextBlock Text="{DynamicResource S.Privacy}" Foreground="#A3ABCC" FontSize="11" TextWrapping="Wrap" Margin="4,12,0,0" LineHeight="17"/>
    </StackPanel>

    <StackPanel>
     <Button x:Name="NavCleanupButton" AutomationProperties.AutomationId="NavCleanupButton" Style="{StaticResource Nav}" Tag="&#xE74D;" Content="{DynamicResource S.Nav.Cleanup}" Click="NavCleanup_Click"/>
     <Button x:Name="NavRegistryButton" AutomationProperties.AutomationId="NavRegistryButton" Style="{StaticResource Nav}" Tag="&#xE90F;" Content="{DynamicResource S.Nav.Registry}" Click="NavRegistry_Click"/>
     <Button x:Name="NavStartupButton" AutomationProperties.AutomationId="NavStartupButton" Style="{StaticResource Nav}" Tag="&#xE7E8;" Content="{DynamicResource S.Nav.Startup}" Click="NavStartup_Click"/>
     <Button x:Name="NavSettingsButton" AutomationProperties.AutomationId="NavSettingsButton" Style="{StaticResource Nav}" Tag="&#xE713;" Content="{DynamicResource S.Nav.Settings}" Click="NavSettings_Click"/>
     <Border CornerRadius="12" Background="#0FFFFFFF" Margin="18,26,18,0" Padding="14,12">
      <StackPanel>
       <TextBlock Text="&#xE946;" FontFamily="{StaticResource Icons}" Foreground="#9AA3C7" FontSize="14"/>
       <TextBlock Text="{DynamicResource S.SidebarNote}" Foreground="#A3ABCC" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="17"/>
      </StackPanel>
     </Border>
    </StackPanel>
   </DockPanel>
  </Border>

  <Grid Grid.Column="1" Margin="30,26,30,20">

   <!-- ═════════════ Limpieza personalizada ═════════════ -->
   <Grid x:Name="CleanupPage" AutomationProperties.AutomationId="CleanupPage" RenderTransformOrigin="0.5,0.5">
    <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <StackPanel Margin="0,0,0,16">
     <TextBlock Text="{DynamicResource S.Cleanup.Title}" Style="{StaticResource PageTitle}"/>
     <TextBlock Text="{DynamicResource S.Cleanup.Subtitle}" Style="{StaticResource PageSubtitle}"/>
    </StackPanel>

    <!-- Lo principal: cuánto espacio se puede liberar y en qué. -->
    <Border Grid.Row="1" Style="{StaticResource HeroCard}" Padding="22,16" Margin="0,0,0,14">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <DockPanel>
       <Border x:Name="HeroBadge" DockPanel.Dock="Left" Width="58" Height="58" CornerRadius="17" Background="{DynamicResource AccentGradient}" VerticalAlignment="Center" Margin="0,0,18,0">
        <TextBlock x:Name="HeroGlyph" Text="&#xEDA2;" Style="{StaticResource BadgeGlyph}" FontSize="24"/>
       </Border>
       <StackPanel VerticalAlignment="Center">
        <TextBlock AutomationProperties.AutomationId="HeroLabel" Text="{Binding HeroLabel}" Foreground="{DynamicResource InkSoft}" FontSize="13.5" FontWeight="SemiBold"/>
        <TextBlock AutomationProperties.AutomationId="SizeText" Text="{Binding SizeText}" FontSize="38" FontWeight="Bold" Foreground="{DynamicResource Ink}" Margin="0,0,0,2"/>
        <TextBlock AutomationProperties.AutomationId="HeroHint" Text="{Binding HeroHint}" Style="{StaticResource StatHint}" FontSize="12"/>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
         <Border Style="{StaticResource Chip}" Background="{DynamicResource Surface}" Margin="0,0,8,0">
          <StackPanel Orientation="Horizontal"><TextBlock Text="{DynamicResource S.Hero.Items}" Style="{StaticResource ChipText}" FontWeight="Normal"/><TextBlock AutomationProperties.AutomationId="FilesText" Text="{Binding FilesText}" Style="{StaticResource ChipText}" Foreground="{DynamicResource Ink}" Margin="5,0,0,0"/></StackPanel>
         </Border>
         <Border Style="{StaticResource Chip}" Background="{DynamicResource Surface}">
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73A;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock AutomationProperties.AutomationId="SelectionText" Text="{Binding SelectionText}" Style="{StaticResource ChipText}" Foreground="{DynamicResource Ink}"/></StackPanel>
         </Border>
         <Border Style="{StaticResource Chip}" Background="{DynamicResource Surface}" Margin="8,0,0,0" Visibility="{Binding HasTotalFreed, Converter={StaticResource Visible}}">
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9F9;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{DynamicResource Success}" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock AutomationProperties.AutomationId="TotalFreedText" Text="{Binding TotalFreedText}" Style="{StaticResource ChipText}" Foreground="{DynamicResource Ink}"/></StackPanel>
         </Border>
        </StackPanel>
       </StackPanel>
      </DockPanel>
      <!-- Desglose por aplicación. -->
      <StackPanel Grid.Column="1" MinWidth="330" Margin="24,0,0,0" VerticalAlignment="Center" Visibility="{Binding HasBreakdown, Converter={StaticResource Visible}}">
       <TextBlock Text="{DynamicResource S.Hero.ByApp}" Foreground="{DynamicResource InkSoft}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
       <ItemsControl AutomationProperties.AutomationId="Breakdown" ItemsSource="{Binding Breakdown}">
        <ItemsControl.ItemTemplate>
         <DataTemplate>
          <Grid Margin="0,2">
           <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="158"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <TextBlock Text="{Binding App}" Foreground="{DynamicResource Ink}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding App}"/>
           <Grid Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
            <Border Height="7" CornerRadius="4" Background="{DynamicResource TrackFill}"/>
            <Border Height="7" CornerRadius="4" Background="{DynamicResource AccentGradient}" Width="{Binding BarWidth}" HorizontalAlignment="Left"/>
           </Grid>
           <TextBlock Grid.Column="2" Text="{Binding Size}" Foreground="{DynamicResource Ink}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="70" TextAlignment="Right"/>
          </Grid>
         </DataTemplate>
        </ItemsControl.ItemTemplate>
       </ItemsControl>
      </StackPanel>
     </Grid>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,14">
     <DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}">
       <TextBlock AutomationProperties.AutomationId="ProgressText" Text="{Binding ProgressText}" Foreground="{DynamicResource InkSoft}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
       <ProgressBar AutomationProperties.AutomationId="CleanupProgress" Width="230" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,6,0"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
       <Button AutomationProperties.AutomationId="AnalyzeButton" Tag="&#xE721;" Content="{DynamicResource S.Analyze}" Style="{StaticResource Primary}" Command="{Binding AnalyzeCommand}"/>
       <Button AutomationProperties.AutomationId="CleanButton" Tag="&#xE74D;" Content="{DynamicResource S.Clean}" Style="{StaticResource Go}" Command="{Binding CleanCommand}"/>
       <Button AutomationProperties.AutomationId="CancelCleanupButton" Tag="&#xE711;" Content="{DynamicResource S.Cancel}" Command="{Binding CancelCommand}"/>
       <Border Width="1" Background="{DynamicResource Line}" Margin="4,6,12,6"/>
       <Button AutomationProperties.AutomationId="SelectAllButton" Tag="&#xE8B3;" Content="{DynamicResource S.SelectAll}" Style="{StaticResource Ghost}" Command="{Binding SelectAllCommand}"/>
       <Button AutomationProperties.AutomationId="ClearSelectionButton" Tag="&#xE894;" Content="{DynamicResource S.ClearAll}" Style="{StaticResource Ghost}" Command="{Binding ClearSelectionCommand}"/>
      </StackPanel>
     </DockPanel>
    </Border>

    <Border Grid.Row="3" Background="{DynamicResource DangerSoft}" BorderBrush="{DynamicResource DangerLine}" BorderThickness="1" CornerRadius="14" Padding="16,12" Margin="0,0,0,14" Visibility="{Binding IsConfirming, Converter={StaticResource Visible}}">
     <DockPanel>
      <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="17" Background="{DynamicResource DangerBrush}" Margin="0,0,14,0" VerticalAlignment="Center"><TextBlock Text="&#xE7BA;" Style="{StaticResource BadgeGlyph}" FontSize="15"/></Border>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0"><Button AutomationProperties.AutomationId="ConfirmCleanButton" Tag="&#xE74D;" Content="{DynamicResource S.ConfirmClean}" Style="{StaticResource Danger}" Command="{Binding ConfirmCleanCommand}"/><Button AutomationProperties.AutomationId="DismissCleanButton" Content="{DynamicResource S.No}" Command="{Binding DismissCommand}" Margin="0"/></StackPanel>
      <TextBlock AutomationProperties.AutomationId="ConfirmCleanText" Text="{Binding ConfirmText}" TextWrapping="Wrap" Foreground="{DynamicResource DangerInk}" VerticalAlignment="Center"/>
     </DockPanel>
    </Border>

    <Grid Grid.Row="4">
     <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" MinWidth="560"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

     <!-- Qué limpiar: aplicaciones a la izquierda, categorías de la elegida a la derecha. -->
     <Border Style="{StaticResource Card}" Padding="0">
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <DockPanel Margin="18,14,18,10">
        <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Background="{DynamicResource WarningSoft}" Visibility="{Binding HasCatalogNotes, Converter={StaticResource Visible}}" ToolTip="{Binding CatalogNotes}">
         <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE946;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{DynamicResource WarningInk}" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="{DynamicResource S.CatalogNotes}" Style="{StaticResource ChipText}" Foreground="{DynamicResource WarningInk}"/></StackPanel>
        </Border>
        <TextBlock Text="&#xE71C;" Style="{StaticResource SectionGlyph}"/>
        <TextBlock Text="{DynamicResource S.WhatToClean}" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
       </DockPanel>
       <Grid Grid.Row="1" IsEnabled="{Binding IsIdle}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <ListBox AutomationProperties.AutomationId="AppList" ItemsSource="{Binding AppsView}" SelectedItem="{Binding SelectedApp, Mode=TwoWay}" ItemContainerStyle="{StaticResource AppItem}"
                 Background="Transparent" BorderThickness="0" Padding="10,0,8,10" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
         <ListBox.GroupStyle>
          <GroupStyle>
           <GroupStyle.HeaderTemplate>
            <DataTemplate><TextBlock Text="{Binding Name}" Foreground="{DynamicResource InkMuted}" FontSize="11" FontWeight="SemiBold" Margin="10,12,0,4"/></DataTemplate>
           </GroupStyle.HeaderTemplate>
          </GroupStyle>
         </ListBox.GroupStyle>
         <ListBox.ItemTemplate>
          <DataTemplate>
           <DockPanel>
            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsChecked, Mode=TwoWay}" AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding Title}" VerticalAlignment="Center" Margin="0,0,10,0" Click="AppCheck_Click"/>
            <StackPanel VerticalAlignment="Center">
             <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis"/>
             <TextBlock Text="{Binding CountText}" Foreground="{DynamicResource InkMuted}" FontSize="11" Margin="0,1,0,0"/>
            </StackPanel>
           </DockPanel>
          </DataTemplate>
         </ListBox.ItemTemplate>
        </ListBox>
        <Border Grid.Column="1" Background="{DynamicResource Line}" Margin="0,0,0,12"/>
        <DockPanel Grid.Column="2" Margin="18,0,12,12">
         <DockPanel DockPanel.Dock="Top" Margin="0,2,0,10">
          <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="10" Background="{DynamicResource AccentGradient}" Margin="0,0,12,0"><TextBlock Text="{Binding SelectedApp.Initial}" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel VerticalAlignment="Center">
           <TextBlock AutomationProperties.AutomationId="SelectedAppTitle" Text="{Binding SelectedApp.Title}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
           <TextBlock Text="{Binding SelectedApp.CountText}" Foreground="{DynamicResource InkMuted}" FontSize="11.5"/>
          </StackPanel>
         </DockPanel>
         <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl AutomationProperties.AutomationId="CategoryList" ItemsSource="{Binding SelectedApp.Children}">
           <ItemsControl.ItemTemplate>
            <DataTemplate>
             <Border x:Name="Row" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="{DynamicResource Surface}" Padding="12,10" Margin="0,0,6,8" Cursor="Hand" MouseLeftButtonUp="CategoryCard_Click">
              <DockPanel>
               <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsChecked, Mode=TwoWay}" AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding Title}" VerticalAlignment="Top" Margin="0,1,12,0"/>
               <StackPanel>
                <WrapPanel>
                 <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" Margin="0,0,8,0"/>
                 <Border x:Name="Badge" CornerRadius="7" Padding="7,1" VerticalAlignment="Center" Background="{DynamicResource AccentSoft}" Visibility="{Binding HasBadge, Converter={StaticResource Visible}}">
                  <TextBlock x:Name="BadgeText" Text="{Binding Badge}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentInk}"/>
                 </Border>
                </WrapPanel>
                <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource InkSoft}" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0" Visibility="{Binding HasDetail, Converter={StaticResource Visible}}"/>
                <ItemsControl ItemsSource="{Binding Children}" Visibility="{Binding HasProfiles, Converter={StaticResource Visible}}">
                 <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                 <ItemsControl.ItemTemplate>
                  <DataTemplate>
                   <CheckBox Style="{StaticResource ProfileChip}" Content="{Binding Title}" IsChecked="{Binding IsChecked, Mode=TwoWay}" AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding Title}"/>
                  </DataTemplate>
                 </ItemsControl.ItemTemplate>
                </ItemsControl>
               </StackPanel>
              </DockPanel>
             </Border>
             <DataTemplate.Triggers>
              <Trigger SourceName="Row" Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentLine}"/></Trigger>
              <DataTrigger Binding="{Binding IsChecked}" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverFill}"/></DataTrigger>
              <DataTrigger Binding="{Binding BadgeKind}" Value="DatosPersonales"><Setter TargetName="Badge" Property="Background" Value="{DynamicResource DangerSoft}"/><Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource DangerInk}"/></DataTrigger>
              <DataTrigger Binding="{Binding BadgeKind}" Value="MuyGrande"><Setter TargetName="Badge" Property="Background" Value="{DynamicResource WarningSoft}"/><Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource WarningInk}"/></DataTrigger>
             </DataTemplate.Triggers>
            </DataTemplate>
           </ItemsControl.ItemTemplate>
          </ItemsControl>
         </ScrollViewer>
        </DockPanel>
       </Grid>
      </Grid>
     </Border>

     <!-- Resultados por objetivo: sin lista de archivos; el motivo de lo que se conserva, debajo. -->
     <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <DockPanel Margin="18,14,18,10">
        <TextBlock Text="&#xE9D2;" Style="{StaticResource SectionGlyph}"/>
        <TextBlock Text="{DynamicResource S.Results}" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
       </DockPanel>
       <DataGrid Grid.Row="1" AutomationProperties.AutomationId="ResultsGrid" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult, Mode=TwoWay}" SelectionMode="Single" IsReadOnly="True" RowHeight="46" Margin="6,0" Visibility="{Binding HasResults, Converter={StaticResource Visible}}">
        <DataGrid.Columns>
         <DataGridTemplateColumn Width="*" MinWidth="170">
          <DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource S.Col.Target}"/></DataGridTemplateColumn.Header>
          <DataGridTemplateColumn.CellTemplate><DataTemplate>
           <DockPanel VerticalAlignment="Center">
            <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="8" Background="{DynamicResource AccentGradient}" Margin="0,0,10,0"><TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <StackPanel>
             <TextBlock Text="{Binding Category}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Category}"/>
             <TextBlock Foreground="{DynamicResource InkMuted}" FontSize="11" TextTrimming="CharacterEllipsis"><Run Text="{Binding Subtitle, Mode=OneWay}"/></TextBlock>
            </StackPanel>
           </DockPanel>
          </DataTemplate></DataGridTemplateColumn.CellTemplate>
         </DataGridTemplateColumn>
         <DataGridTemplateColumn Width="126">
          <DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource S.Col.Size}"/></DataGridTemplateColumn.Header>
          <DataGridTemplateColumn.CellTemplate><DataTemplate>
           <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Size}" FontWeight="SemiBold"/>
            <Grid Width="96" HorizontalAlignment="Left" Margin="0,4,0,0">
             <Border Height="5" CornerRadius="3" Background="{DynamicResource TrackFill}"/>
             <Border Height="5" CornerRadius="3" Background="{DynamicResource AccentGradient}" Width="{Binding ShareWidth}" HorizontalAlignment="Left"/>
            </Grid>
           </StackPanel>
          </DataTemplate></DataGridTemplateColumn.CellTemplate>
         </DataGridTemplateColumn>
         <DataGridTemplateColumn Width="*" MinWidth="140">
          <DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource S.Col.State}"/></DataGridTemplateColumn.Header>
          <DataGridTemplateColumn.CellTemplate><DataTemplate>
           <Border x:Name="Chip" Style="{StaticResource Chip}" Background="{DynamicResource SuccessSoft}" ToolTip="{Binding State}">
            <TextBlock x:Name="ChipText" Text="{Binding State}" Style="{StaticResource ChipText}" Foreground="{DynamicResource SuccessInk}" TextTrimming="CharacterEllipsis"/>
           </Border>
           <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding HasNotes}" Value="True"><Setter TargetName="Chip" Property="Background" Value="{DynamicResource WarningSoft}"/><Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource WarningInk}"/></DataTrigger>
           </DataTemplate.Triggers>
          </DataTemplate></DataGridTemplateColumn.CellTemplate>
         </DataGridTemplateColumn>
        </DataGrid.Columns>
       </DataGrid>
       <!-- Guía cuando aún no hay resultados. -->
       <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowEmptyState, Converter={StaticResource Visible}}" IsHitTestVisible="False" Margin="20,0,20,30">
        <Border Width="72" Height="72" CornerRadius="36" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Center">
         <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="28" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="{DynamicResource S.Empty.Title}" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,14,0,0" Foreground="{DynamicResource Ink}"/>
        <TextBlock Text="{DynamicResource S.Empty.Steps}" Foreground="{DynamicResource InkSoft}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" MaxWidth="360"/>
        <TextBlock Text="{DynamicResource S.Empty.Safe}" Foreground="{DynamicResource InkMuted}" FontSize="11.5" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" MaxWidth="360"/>
       </StackPanel>
       <Border Grid.Row="2" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" CornerRadius="0,0,16,16" Padding="18,10,18,12" Visibility="{Binding HasResults, Converter={StaticResource Visible}}">
        <StackPanel>
         <TextBlock AutomationProperties.AutomationId="DetailTitle" Text="{Binding DetailTitle}" Foreground="{DynamicResource Ink}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding DetailTitle}"/>
         <TextBlock AutomationProperties.AutomationId="DetailSummary" Text="{Binding DetailSummary}" Foreground="{DynamicResource InkSoft}" FontSize="11.5" TextWrapping="Wrap" MaxHeight="46" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" ToolTip="{Binding DetailSummary}" Visibility="{Binding HasDetailSummary, Converter={StaticResource Visible}}"/>
        </StackPanel>
       </Border>
      </Grid>
     </Border>
    </Grid>

    <Border Grid.Row="5" Style="{StaticResource Card}" Padding="16,12" Margin="0,14,0,0">
     <DockPanel>
      <TextBlock DockPanel.Dock="Left" Text="&#xE946;" FontFamily="{StaticResource Icons}" FontSize="15" Foreground="{DynamicResource Accent}" Margin="0,1,12,0" VerticalAlignment="Top"/>
      <StackPanel>
       <TextBlock AutomationProperties.AutomationId="CleanupStatus" Text="{Binding Status}" Foreground="{DynamicResource Ink}" TextWrapping="Wrap"/>
       <TextBlock AutomationProperties.AutomationId="TimingText" Text="{Binding TimingText}" Foreground="{DynamicResource InkMuted}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
       <TextBox AutomationProperties.AutomationId="IssuesText" Text="{Binding IssuesText, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap" FontSize="11" Foreground="{DynamicResource WarningInk}" Background="{DynamicResource WarningSoft}" BorderBrush="{DynamicResource WarningLine}" Padding="6,4" MaxHeight="58" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Visibility="{Binding HasIssues, Converter={StaticResource Visible}}"/>
      </StackPanel>
     </DockPanel>
    </Border>
   </Grid>

   <!-- ═════════════ Registro ═════════════ -->
   <Grid x:Name="RegistryPage" AutomationProperties.AutomationId="RegistryPage" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
    <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <DockPanel Margin="0,0,0,16">
     <Button DockPanel.Dock="Right" AutomationProperties.AutomationId="ElevateButton" Tag="&#xE7EF;" Content="{DynamicResource S.Elevate}" Command="{Binding ElevateCommand}" Visibility="{Binding CanElevate, Converter={StaticResource Visible}}" VerticalAlignment="Top" Margin="0"/>
     <StackPanel>
      <TextBlock Text="{DynamicResource S.Registry.Title}" Style="{StaticResource PageTitle}"/>
      <TextBlock Text="{Binding ScopeDescription}" Style="{StaticResource PageSubtitle}"/>
      <Border Margin="0,8,0,0" CornerRadius="9" Background="{DynamicResource WarningSoft}" Padding="10,5" HorizontalAlignment="Left">
       <TextBlock Text="{Binding ElevationNote}" Foreground="{DynamicResource WarningInk}" FontSize="11.5" TextWrapping="Wrap"/>
      </Border>
     </StackPanel>
    </DockPanel>

    <ItemsControl Grid.Row="1" ItemsSource="{Binding Families}" IsEnabled="{Binding IsIdle}" Margin="0,0,-10,4">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate>
      <DataTemplate>
       <CheckBox Style="{StaticResource Tile}" IsChecked="{Binding IsChecked, Mode=TwoWay}" AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding Name}">
        <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/><TextBlock Text="{Binding Description}" Foreground="{DynamicResource InkMuted}" FontSize="10.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}" Margin="0,2,0,0"/></StackPanel>
       </CheckBox>
      </DataTemplate>
     </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,14">
     <DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
       <ProgressBar Width="160" IsIndeterminate="True" VerticalAlignment="Center" Margin="0,0,16,0" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}"/>
       <CheckBox AutomationProperties.AutomationId="OnlyRepairableBox" Style="{StaticResource Switch}" Content="{DynamicResource S.OnlyRepairable}" IsChecked="{Binding OnlyRepairable, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,6,0"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
       <Button AutomationProperties.AutomationId="ScanRegistryButton" Tag="&#xE721;" Content="{DynamicResource S.ScanRegistry}" Style="{StaticResource Primary}" Command="{Binding ScanCommand}"/>
       <Button AutomationProperties.AutomationId="RepairButton" Tag="&#xE90F;" Content="{DynamicResource S.Repair}" Style="{StaticResource Go}" Command="{Binding RepairCommand}"/>
       <Button AutomationProperties.AutomationId="CancelRegistryButton" Tag="&#xE711;" Content="{DynamicResource S.Cancel}" Command="{Binding CancelCommand}"/>
       <Border Width="1" Background="{DynamicResource Line}" Margin="4,6,12,6"/>
       <Button AutomationProperties.AutomationId="SelectSafeButton" Tag="&#xE8B3;" Content="{DynamicResource S.SelectSafe}" Style="{StaticResource Ghost}" Command="{Binding SelectSafeCommand}"/>
       <Button AutomationProperties.AutomationId="ClearRegistrySelectionButton" Tag="&#xE894;" Content="{DynamicResource S.Unselect}" Style="{StaticResource Ghost}" Command="{Binding ClearSelectionCommand}"/>
      </StackPanel>
     </DockPanel>
    </Border>

    <Border Grid.Row="3" Background="{DynamicResource DangerSoft}" BorderBrush="{DynamicResource DangerLine}" BorderThickness="1" CornerRadius="14" Padding="16,12" Margin="0,0,0,14" Visibility="{Binding IsConfirming, Converter={StaticResource Visible}}">
     <DockPanel>
      <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="17" Background="{DynamicResource DangerBrush}" Margin="0,0,14,0" VerticalAlignment="Center"><TextBlock Text="&#xE7BA;" Style="{StaticResource BadgeGlyph}" FontSize="15"/></Border>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0"><Button AutomationProperties.AutomationId="ConfirmRegistryButton" Content="{DynamicResource S.Continue}" Style="{StaticResource Danger}" Command="{Binding ConfirmCommand}"/><Button AutomationProperties.AutomationId="DismissRegistryButton" Content="{DynamicResource S.No}" Command="{Binding DismissCommand}" Margin="0"/></StackPanel>
      <TextBlock AutomationProperties.AutomationId="ConfirmRegistryText" Text="{Binding ConfirmText}" TextWrapping="Wrap" Foreground="{DynamicResource DangerInk}" VerticalAlignment="Center"/>
     </DockPanel>
    </Border>

    <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Margin="18,14,18,10">
       <TextBlock DockPanel.Dock="Right" Text="{Binding RiskSummary}" Foreground="{DynamicResource InkSoft}" FontSize="11.5" VerticalAlignment="Center"/>
       <TextBlock Text="&#xE9D9;" Style="{StaticResource SectionGlyph}"/>
       <TextBlock Text="{DynamicResource S.Findings}" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
      </DockPanel>
      <DataGrid Grid.Row="1" AutomationProperties.AutomationId="RegistryGrid" ItemsSource="{Binding FindingsView}" RowHeight="36" Margin="6,0,6,6">
       <DataGrid.Columns>
        <DataGridTemplateColumn Width="44"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanRepair}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTemplateColumn Width="110" IsReadOnly="True">
         <DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource S.Col.Risk}"/></DataGridTemplateColumn.Header>
         <DataGridTemplateColumn.CellTemplate><DataTemplate>
          <Border x:Name="Chip" Style="{StaticResource Chip}">
           <TextBlock x:Name="ChipText" Text="{Binding Risk}" Style="{StaticResource ChipText}"/>
          </Border>
          <DataTemplate.Triggers>
           <DataTrigger Binding="{Binding RiskKey}" Value="Seguro"><Setter TargetName="Chip" Property="Background" Value="{DynamicResource SuccessSoft}"/><Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource SuccessInk}"/></DataTrigger>
           <DataTrigger Binding="{Binding RiskKey}" Value="Ambiguo"><Setter TargetName="Chip" Property="Background" Value="{DynamicResource WarningSoft}"/><Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource WarningInk}"/></DataTrigger>
           <DataTrigger Binding="{Binding RiskKey}" Value="Critico"><Setter TargetName="Chip" Property="Background" Value="{DynamicResource DangerSoft}"/><Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource DangerInk}"/></DataTrigger>
          </DataTemplate.Triggers>
         </DataTemplate></DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Binding="{Binding Family}" Width="170" IsReadOnly="True" ElementStyle="{StaticResource CellTip}"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource S.Col.Family}"/></DataGridTextColumn.Header></DataGridTextColumn>
        <DataGridTextColumn Binding="{Binding Location}" Width="2*" IsReadOnly="True" ElementStyle="{StaticResource CellTip}"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource S.Col.Key}"/></DataGridTextColumn.Header></DataGridTextColumn>
        <DataGridTextColumn Binding="{Binding Value}" Width="*" IsReadOnly="True" ElementStyle="{StaticResource MutedCell}"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource S.Col.Value}"/></DataGridTextColumn.Header></DataGridTextColumn>
        <DataGridTextColumn Binding="{Binding Target}" Width="*" IsReadOnly="True" ElementStyle="{StaticResource MutedCell}"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource S.Col.Destination}"/></DataGridTextColumn.Header></DataGridTextColumn>
        <DataGridTextColumn Binding="{Binding Evidence}" Width="2*" IsReadOnly="True" ElementStyle="{StaticResource MutedCell}"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource S.Col.Evidence}"/></DataGridTextColumn.Header></DataGridTextColumn>
       </DataGrid.Columns>
      </DataGrid>
      <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowFilteredEmpty, Converter={StaticResource Visible}}" IsHitTestVisible="False" Margin="30,0,30,20">
       <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource SuccessSoft}" HorizontalAlignment="Center">
        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="26" Foreground="{DynamicResource Success}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       </Border>
       <TextBlock AutomationProperties.AutomationId="FilteredEmptyText" Text="{Binding FilteredEmptyText}" Foreground="{DynamicResource InkSoft}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="520" Margin="0,12,0,0"/>
      </StackPanel>
      <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowEmptyState, Converter={StaticResource Visible}}" IsHitTestVisible="False" Margin="0,0,0,20">
       <Border Width="72" Height="72" CornerRadius="36" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Center">
        <TextBlock Text="&#xE90F;" FontFamily="{StaticResource Icons}" FontSize="28" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       </Border>
       <TextBlock Text="{DynamicResource S.Registry.EmptyTitle}" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,14,0,0" Foreground="{DynamicResource Ink}"/>
       <TextBlock Text="{DynamicResource S.Registry.EmptyText}" Foreground="{DynamicResource InkSoft}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
      </StackPanel>
     </Grid>
    </Border>

    <Border Grid.Row="5" Style="{StaticResource Card}" Padding="16,10" Margin="0,14,0,0">
     <DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
       <Button AutomationProperties.AutomationId="RestoreButton" Tag="&#xE777;" Content="{DynamicResource S.Restore}" Command="{Binding RestoreCommand}"/>
       <Button AutomationProperties.AutomationId="OpenBackupsButton" Tag="&#xE838;" Content="{DynamicResource S.OpenFolder}" Style="{StaticResource Ghost}" Command="{Binding OpenBackupsCommand}" Margin="0" ToolTip="{Binding BackupDirectory}"/>
      </StackPanel>
      <TextBlock DockPanel.Dock="Left" Text="&#xE777;" Style="{StaticResource SectionGlyph}"/>
      <TextBlock DockPanel.Dock="Left" Text="{DynamicResource S.Backups}" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0,0,14,0"/>
      <ComboBox AutomationProperties.AutomationId="BackupsBox" ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup, Mode=TwoWay}" DisplayMemberPath="Display" Margin="0,0,12,0" IsEnabled="{Binding IsIdle}" VerticalAlignment="Center"/>
     </DockPanel>
    </Border>

    <!-- Estado accesible: no ocupa espacio en pantalla; lo leen los lectores de pantalla. Los resultados se ven en los avisos. -->
    <TextBlock Grid.Row="6" AutomationProperties.AutomationId="RegistryStatus" AutomationProperties.LiveSetting="Polite" Text="{Binding Status}" Height="0" Margin="0" Focusable="False" IsHitTestVisible="False"/>
   </Grid>

   <!-- ═════════════ Inicio de Windows ═════════════ -->
   <Grid x:Name="StartupPage" AutomationProperties.AutomationId="StartupPage" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
    <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <DockPanel Margin="0,0,0,18">
     <Button DockPanel.Dock="Right" AutomationProperties.AutomationId="StartupElevateButton" Tag="&#xE7EF;" Content="{DynamicResource S.Elevate}" Command="{Binding ElevateCommand}" Visibility="{Binding CanElevate, Converter={StaticResource Visible}}" VerticalAlignment="Top" Margin="0"/>
     <StackPanel>
      <TextBlock Text="{DynamicResource S.Startup.Title}" Style="{StaticResource PageTitle}"/>
      <TextBlock Text="{DynamicResource S.Startup.Subtitle}" Style="{StaticResource PageSubtitle}"/>
      <Border Margin="0,8,0,0" CornerRadius="9" Background="{DynamicResource WarningSoft}" Padding="10,5" HorizontalAlignment="Left">
       <TextBlock Text="{Binding Note}" Foreground="{DynamicResource WarningInk}" FontSize="11.5" TextWrapping="Wrap"/>
      </Border>
     </StackPanel>
    </DockPanel>

    <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,16">
     <Border Style="{StaticResource StatCard}">
      <DockPanel>
       <Border DockPanel.Dock="Left" Style="{StaticResource IconBadge}" Margin="0,0,14,0"><TextBlock Text="&#xE7E8;" Style="{StaticResource BadgeGlyph}"/></Border>
       <StackPanel><TextBlock Text="{DynamicResource S.Startup.Programs}" Style="{StaticResource SectionLabel}"/><TextBlock AutomationProperties.AutomationId="StartupTotalText" Text="{Binding TotalCount}" Style="{StaticResource StatValue}"/><TextBlock Text="{DynamicResource S.Startup.ProgramsHint}" Style="{StaticResource StatHint}"/></StackPanel>
      </DockPanel>
     </Border>
     <Border Style="{StaticResource StatCard}">
      <DockPanel>
       <Border DockPanel.Dock="Left" Style="{StaticResource IconBadge}" Margin="0,0,14,0">
        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#0891B2" Offset="0"/><GradientStop Color="#0E9F6E" Offset="1"/></LinearGradientBrush></Border.Background>
        <TextBlock Text="&#xE768;" Style="{StaticResource BadgeGlyph}"/>
       </Border>
       <StackPanel><TextBlock Text="{DynamicResource S.Startup.Enabled}" Style="{StaticResource SectionLabel}"/><TextBlock AutomationProperties.AutomationId="StartupEnabledText" Text="{Binding EnabledCount}" Style="{StaticResource StatValue}"/><TextBlock Text="{DynamicResource S.Startup.EnabledHint}" Style="{StaticResource StatHint}"/></StackPanel>
      </DockPanel>
     </Border>
     <Border Style="{StaticResource StatCard}" Margin="0">
      <DockPanel>
       <Border DockPanel.Dock="Left" Style="{StaticResource IconBadge}" Margin="0,0,14,0">
        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#94A3B8" Offset="0"/><GradientStop Color="#64748B" Offset="1"/></LinearGradientBrush></Border.Background>
        <TextBlock Text="&#xE769;" Style="{StaticResource BadgeGlyph}"/>
       </Border>
       <StackPanel><TextBlock Text="{DynamicResource S.Startup.Disabled}" Style="{StaticResource SectionLabel}"/><TextBlock AutomationProperties.AutomationId="StartupDisabledText" Text="{Binding DisabledCount}" Style="{StaticResource StatValue}"/><TextBlock Text="{DynamicResource S.Startup.DisabledHint}" Style="{StaticResource StatHint}"/></StackPanel>
      </DockPanel>
     </Border>
    </UniformGrid>

    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Margin="18,14,18,10">
       <Button DockPanel.Dock="Right" AutomationProperties.AutomationId="RefreshStartupButton" Tag="&#xE72C;" Content="{DynamicResource S.Refresh}" Style="{StaticResource Ghost}" Command="{Binding RefreshCommand}" Margin="0"/>
       <TextBlock DockPanel.Dock="Right" AutomationProperties.AutomationId="StartupSummary" Text="{Binding Summary}" Foreground="{DynamicResource InkSoft}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,12,0"/>
       <TextBlock Text="&#xE7E8;" Style="{StaticResource SectionGlyph}"/>
       <TextBlock Text="{DynamicResource S.Startup.ListTitle}" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
      </DockPanel>
      <DataGrid Grid.Row="1" AutomationProperties.AutomationId="StartupGrid" ItemsSource="{Binding Entries}" RowHeight="54" Margin="6,0,6,6">
       <DataGrid.Columns>
        <DataGridTemplateColumn Width="3*" MinWidth="260" IsReadOnly="True">
         <DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource S.Col.Program}"/></DataGridTemplateColumn.Header>
         <DataGridTemplateColumn.CellTemplate><DataTemplate>
          <DockPanel VerticalAlignment="Center" ToolTip="{Binding Command}">
           <Grid DockPanel.Dock="Left" Width="34" Height="34" Margin="0,0,12,0">
            <Border x:Name="Fallback" CornerRadius="9" Background="{DynamicResource AccentGradient}"><TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <Image Source="{Binding Icon}" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding HasIcon, Converter={StaticResource Visible}}"/>
           </Grid>
           <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource InkMuted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
           </StackPanel>
          </DockPanel>
          <DataTemplate.Triggers>
           <DataTrigger Binding="{Binding HasIcon}" Value="True"><Setter TargetName="Fallback" Property="Visibility" Value="Collapsed"/></DataTrigger>
          </DataTemplate.Triggers>
         </DataTemplate></DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Width="160">
         <DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource S.Col.Status}"/></DataGridTemplateColumn.Header>
         <DataGridTemplateColumn.CellTemplate><DataTemplate>
          <CheckBox Style="{StaticResource Switch}" VerticalAlignment="Center" IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanToggle}" AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding Name}" Content="{Binding ToggleHint}" ToolTip="{Binding ToggleHint}"/>
         </DataTemplate></DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Width="215" IsReadOnly="True">
         <DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource S.Col.Source}"/></DataGridTemplateColumn.Header>
         <DataGridTemplateColumn.CellTemplate><DataTemplate>
          <Border Style="{StaticResource Chip}"><TextBlock Text="{Binding Source}" Style="{StaticResource ChipText}" FontWeight="Normal"/></Border>
         </DataTemplate></DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Binding="{Binding Command}" Width="2*" IsReadOnly="True" ElementStyle="{StaticResource MutedCell}"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource S.Col.Command}"/></DataGridTextColumn.Header></DataGridTextColumn>
        <DataGridTemplateColumn Width="140" IsReadOnly="True">
         <DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource S.Col.OnDisk}"/></DataGridTemplateColumn.Header>
         <DataGridTemplateColumn.CellTemplate><DataTemplate>
          <Border x:Name="Chip" Style="{StaticResource Chip}" Background="{DynamicResource SuccessSoft}">
           <TextBlock x:Name="ChipText" Text="{Binding TargetText}" Style="{StaticResource ChipText}" Foreground="{DynamicResource SuccessInk}"/>
          </Border>
          <DataTemplate.Triggers>
           <DataTrigger Binding="{Binding TargetKey}" Value="Missing"><Setter TargetName="Chip" Property="Background" Value="{DynamicResource WarningSoft}"/><Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource WarningInk}"/></DataTrigger>
           <DataTrigger Binding="{Binding TargetKey}" Value="Unknown"><Setter TargetName="Chip" Property="Background" Value="{DynamicResource ChipFill}"/><Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource InkSoft}"/></DataTrigger>
          </DataTemplate.Triggers>
         </DataTemplate></DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
       </DataGrid.Columns>
      </DataGrid>
      <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowEmptyState, Converter={StaticResource Visible}}" IsHitTestVisible="False" Margin="0,0,0,20">
       <Border Width="72" Height="72" CornerRadius="36" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Center">
        <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource Icons}" FontSize="28" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       </Border>
       <TextBlock Text="{DynamicResource S.Startup.EmptyTitle}" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,14,0,0" Foreground="{DynamicResource Ink}"/>
       <TextBlock Text="{DynamicResource S.Startup.EmptyText}" Foreground="{DynamicResource InkSoft}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
      </StackPanel>
     </Grid>
    </Border>

    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="16,12" Margin="0,14,0,0">
     <DockPanel>
      <TextBlock DockPanel.Dock="Left" Text="&#xE946;" FontFamily="{StaticResource Icons}" FontSize="15" Foreground="{DynamicResource Accent}" Margin="0,1,12,0"/>
      <TextBlock AutomationProperties.AutomationId="StartupStatus" Text="{Binding Status}" Foreground="{DynamicResource Ink}" TextWrapping="Wrap"/>
     </DockPanel>
    </Border>
   </Grid>

   <!-- ═════════════ Configuración ═════════════ -->
   <ScrollViewer x:Name="SettingsPage" AutomationProperties.AutomationId="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" RenderTransformOrigin="0.5,0.5">
    <ScrollViewer.RenderTransform><TranslateTransform/></ScrollViewer.RenderTransform>
    <StackPanel MaxWidth="980" HorizontalAlignment="Left">
     <TextBlock Text="{DynamicResource S.Settings.Title}" Style="{StaticResource PageTitle}"/>
     <TextBlock Text="{DynamicResource S.Settings.Subtitle}" Style="{StaticResource PageSubtitle}" Margin="0,6,0,18"/>

     <Border Style="{StaticResource Card}" Margin="0,0,0,14">
      <StackPanel>
       <DockPanel><TextBlock Text="&#xE790;" Style="{StaticResource SectionGlyph}"/><TextBlock Text="{DynamicResource S.Settings.Theme}" Style="{StaticResource SectionLabel}"/></DockPanel>
       <TextBlock Text="{DynamicResource S.Settings.ThemeHint}" Style="{StaticResource StatHint}" Margin="0,4,0,12"/>
       <StackPanel Orientation="Horizontal">
        <RadioButton AutomationProperties.AutomationId="ThemeSystem" GroupName="Theme" Style="{StaticResource Choice}" Tag="&#xE770;" Content="{DynamicResource S.Settings.ThemeSystem}" IsChecked="{Binding IsThemeSystem, Mode=TwoWay}"/>
        <RadioButton AutomationProperties.AutomationId="ThemeLight" GroupName="Theme" Style="{StaticResource Choice}" Tag="&#xE706;" Content="{DynamicResource S.Settings.ThemeLight}" IsChecked="{Binding IsThemeLight, Mode=TwoWay}"/>
        <RadioButton AutomationProperties.AutomationId="ThemeDark" GroupName="Theme" Style="{StaticResource Choice}" Tag="&#xE708;" Content="{DynamicResource S.Settings.ThemeDark}" IsChecked="{Binding IsThemeDark, Mode=TwoWay}"/>
       </StackPanel>
      </StackPanel>
     </Border>

     <Border Style="{StaticResource Card}" Margin="0,0,0,14">
      <StackPanel>
       <DockPanel><TextBlock Text="&#xE774;" Style="{StaticResource SectionGlyph}"/><TextBlock Text="{DynamicResource S.Settings.Language}" Style="{StaticResource SectionLabel}"/></DockPanel>
       <TextBlock Text="{DynamicResource S.Settings.LanguageHint}" Style="{StaticResource StatHint}" Margin="0,4,0,12"/>
       <StackPanel Orientation="Horizontal">
        <RadioButton AutomationProperties.AutomationId="LangEs" GroupName="Language" Style="{StaticResource Choice}" Tag="&#xE8C1;" Content="Español" IsChecked="{Binding IsSpanish, Mode=TwoWay}"/>
        <RadioButton AutomationProperties.AutomationId="LangEn" GroupName="Language" Style="{StaticResource Choice}" Tag="&#xE8C1;" Content="English" IsChecked="{Binding IsEnglish, Mode=TwoWay}"/>
       </StackPanel>
      </StackPanel>
     </Border>

     <Border Style="{StaticResource Card}" Margin="0,0,0,14">
      <StackPanel>
       <DockPanel><TextBlock Text="&#xE99A;" Style="{StaticResource SectionGlyph}"/><TextBlock Text="{DynamicResource S.Settings.Agents}" Style="{StaticResource SectionLabel}"/></DockPanel>
       <TextBlock Text="{DynamicResource S.Settings.AgentsHint}" Style="{StaticResource StatHint}" FontSize="12" Margin="0,4,0,12"/>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{DynamicResource S.Settings.McpServer}" Foreground="{DynamicResource InkSoft}" FontSize="12" Margin="0,0,14,6" VerticalAlignment="Center"/>
        <TextBox Grid.Column="1" AutomationProperties.AutomationId="McpPathText" Text="{Binding McpPath, Mode=OneWay}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Background="{DynamicResource SurfaceAlt}" Foreground="{DynamicResource Ink}" Margin="0,0,0,6"/>
        <TextBlock Grid.Row="1" Text="{DynamicResource S.Settings.ClaudeCode}" Foreground="{DynamicResource InkSoft}" FontSize="12" Margin="0,0,14,0" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1" AutomationProperties.AutomationId="McpCommandText" Text="{Binding McpCommand, Mode=OneWay}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Background="{DynamicResource SurfaceAlt}" Foreground="{DynamicResource Ink}"/>
       </Grid>
       <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
        <Button AutomationProperties.AutomationId="CopyMcpCommandButton" Tag="&#xE8C8;" Content="{DynamicResource S.Settings.CopyCommand}" Style="{StaticResource Primary}" Command="{Binding CopyCommandCommand}"/>
        <Button AutomationProperties.AutomationId="CopyMcpJsonButton" Tag="&#xE943;" Content="{DynamicResource S.Settings.CopyJson}" Command="{Binding CopyJsonCommand}"/>
       </StackPanel>
       <TextBlock Text="{Binding McpAvailability}" Foreground="{DynamicResource WarningInk}" FontSize="11.5" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding HasMcpWarning, Converter={StaticResource Visible}}"/>
       <TextBlock Text="{DynamicResource S.Settings.AgentsAllow}" Foreground="{DynamicResource InkSoft}" FontSize="12" FontWeight="SemiBold" Margin="0,16,0,8"/>
       <CheckBox AutomationProperties.AutomationId="AgentsPersonalBox" Style="{StaticResource Switch}" Content="{DynamicResource S.Settings.AgentsPersonal}" IsChecked="{Binding AgentsMayDeletePersonalData, Mode=TwoWay}"/>
       <CheckBox AutomationProperties.AutomationId="AgentsRegistryBox" Style="{StaticResource Switch}" Content="{DynamicResource S.Settings.AgentsRegistry}" IsChecked="{Binding AgentsMayChangeRegistry, Mode=TwoWay}" Margin="0,8,0,0"/>
       <TextBlock Text="{DynamicResource S.Settings.AgentsSafety}" Style="{StaticResource StatHint}" Margin="0,10,0,0"/>
      </StackPanel>
     </Border>

     <Border Style="{StaticResource Card}" Margin="0,0,0,14">
      <StackPanel>
       <DockPanel><TextBlock Text="&#xE895;" Style="{StaticResource SectionGlyph}"/><TextBlock Text="{DynamicResource S.Settings.Updates}" Style="{StaticResource SectionLabel}"/></DockPanel>
       <TextBlock Text="{DynamicResource S.Settings.UpdatesHint}" Style="{StaticResource StatHint}" FontSize="12" Margin="0,4,0,12"/>
       <CheckBox AutomationProperties.AutomationId="AutoUpdateBox" Style="{StaticResource Switch}" Content="{DynamicResource S.Settings.AutoUpdate}" IsChecked="{Binding AutoUpdate, Mode=TwoWay}"/>
       <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
        <Button AutomationProperties.AutomationId="CheckUpdatesButton" Tag="&#xE72C;" Content="{DynamicResource S.Settings.CheckNow}" Command="{Binding CheckUpdatesCommand}"/>
        <TextBlock Foreground="{DynamicResource InkMuted}" FontSize="11.5" VerticalAlignment="Center" Margin="8,0,0,0"><Run Text="{DynamicResource S.Settings.Repository}"/><Run Text=": "/><Run Text="{Binding Updates.RepositoryText, Mode=OneWay}"/></TextBlock>
       </StackPanel>
       <TextBlock AutomationProperties.AutomationId="UpdateStatus" Text="{Binding Updates.Status}" Foreground="{DynamicResource InkSoft}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
      </StackPanel>
     </Border>

     <Border Style="{StaticResource Card}">
      <StackPanel>
       <DockPanel><TextBlock Text="&#xE8B7;" Style="{StaticResource SectionGlyph}"/><TextBlock Text="{DynamicResource S.Settings.Data}" Style="{StaticResource SectionLabel}"/></DockPanel>
       <TextBlock Text="{Binding DataDirectory}" Foreground="{DynamicResource InkSoft}" FontSize="12" Margin="0,6,0,10" TextTrimming="CharacterEllipsis" ToolTip="{Binding DataDirectory}"/>
       <StackPanel Orientation="Horizontal">
        <Button AutomationProperties.AutomationId="OpenDataButton" Tag="&#xE838;" Content="{DynamicResource S.OpenFolder}" Command="{Binding OpenDataCommand}"/>
        <TextBlock Text="{Binding VersionText}" Foreground="{DynamicResource InkMuted}" FontSize="11.5" VerticalAlignment="Center" Margin="8,0,0,0"/>
       </StackPanel>
      </StackPanel>
     </Border>
     <TextBlock AutomationProperties.AutomationId="SettingsStatus" Text="{Binding Status}" Foreground="{DynamicResource InkSoft}" FontSize="12" Margin="2,12,0,0"/>
    </StackPanel>
   </ScrollViewer>
  </Grid>

  <!-- ═════════════ Aviso emergente ═════════════ -->
  <Border x:Name="Toast" Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,30" Width="380"
          CornerRadius="16" Background="#141A2E" BorderBrush="#2E3658" BorderThickness="1" Padding="16,14" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
   <Border.RenderTransform><TranslateTransform Y="0"/></Border.RenderTransform>
   <DockPanel>
    <Border x:Name="ToastBadge" DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="18" Background="{DynamicResource AccentGradient}" Margin="0,0,14,0" VerticalAlignment="Top">
     <TextBlock x:Name="ToastIcon" Text="&#xE73E;" Style="{StaticResource BadgeGlyph}" FontSize="15"/>
    </Border>
    <Button DockPanel.Dock="Right" AutomationProperties.AutomationId="ToastCloseButton" Content="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="10" Style="{StaticResource Ghost}" Foreground="#A3ABCC" Padding="6" Margin="8,0,0,0" VerticalAlignment="Top" Click="ToastClose_Click"/>
    <StackPanel>
     <TextBlock x:Name="ToastTitle" AutomationProperties.AutomationId="ToastTitle" Foreground="White" FontWeight="SemiBold" FontSize="14"/>
     <TextBlock x:Name="ToastMessage" AutomationProperties.AutomationId="ToastMessage" Foreground="#C3C9E0" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
    </StackPanel>
   </DockPanel>
  </Border>
 </Grid>
</Window>
