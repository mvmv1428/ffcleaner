<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!-- Tema claro. Mismas claves que Dark.xaml: la app cambia de diccionario sin reiniciarse. -->
 <SolidColorBrush x:Key="Accent" Color="#5B5FEF"/>
 <SolidColorBrush x:Key="AccentSoft" Color="#EEF0FF"/>
 <SolidColorBrush x:Key="AccentInk" Color="#4338CA"/>
 <SolidColorBrush x:Key="AccentLine" Color="#A5B4FC"/>
 <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
  <GradientStop Color="#5B5FEF" Offset="0"/>
  <GradientStop Color="#0891B2" Offset="1"/>
 </LinearGradientBrush>
 <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="0,1">
  <GradientStop Color="#141537" Offset="0"/>
  <GradientStop Color="#0B1426" Offset="1"/>
 </LinearGradientBrush>
 <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
  <GradientStop Color="#EEF0FF" Offset="0"/>
  <GradientStop Color="#E6F7FA" Offset="1"/>
 </LinearGradientBrush>
 <SolidColorBrush x:Key="DangerBrush" Color="#DC3B41"/>
 <SolidColorBrush x:Key="DangerSoft" Color="#FFF0F0"/>
 <SolidColorBrush x:Key="DangerInk" Color="#A4262C"/>
 <SolidColorBrush x:Key="DangerLine" Color="#F6C3C5"/>
 <SolidColorBrush x:Key="Success" Color="#0E9F6E"/>
 <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0,0" EndPoint="1,1">
  <GradientStop Color="#0E9F6E" Offset="0"/>
  <GradientStop Color="#0D9488" Offset="1"/>
 </LinearGradientBrush>
 <SolidColorBrush x:Key="SuccessSoft" Color="#E7F8F1"/>
 <SolidColorBrush x:Key="SuccessInk" Color="#047857"/>
 <SolidColorBrush x:Key="Warning" Color="#F59E0B"/>
 <SolidColorBrush x:Key="WarningSoft" Color="#FFF7E6"/>
 <SolidColorBrush x:Key="WarningInk" Color="#8A5208"/>
 <SolidColorBrush x:Key="WarningLine" Color="#F6DFB2"/>
 <SolidColorBrush x:Key="DisabledFill" Color="#ECEEF4"/>
 <SolidColorBrush x:Key="DisabledInk" Color="#8C93A6"/>
 <SolidColorBrush x:Key="Canvas" Color="#F4F6FB"/>
 <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
 <SolidColorBrush x:Key="SurfaceAlt" Color="#F8F9FD"/>
 <SolidColorBrush x:Key="HoverFill" Color="#F3F4FD"/>
 <SolidColorBrush x:Key="ChipFill" Color="#EEF0F6"/>
 <SolidColorBrush x:Key="TrackFill" Color="#E5E8F2"/>
 <SolidColorBrush x:Key="GridLine" Color="#EEF0F6"/>
 <SolidColorBrush x:Key="Line" Color="#E2E5EE"/>
 <SolidColorBrush x:Key="LineStrong" Color="#C5CAD8"/>
 <SolidColorBrush x:Key="PressOverlay" Color="#0F1530"/>
 <SolidColorBrush x:Key="Ink" Color="#141A2E"/>
 <SolidColorBrush x:Key="InkSoft" Color="#475066"/>
 <SolidColorBrush x:Key="InkMuted" Color="#5E6679"/>
</ResourceDictionary>
