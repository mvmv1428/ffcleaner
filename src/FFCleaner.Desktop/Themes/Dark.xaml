<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!-- Tema oscuro. Mismas claves que Light.xaml. -->
 <SolidColorBrush x:Key="Accent" Color="#818CF8"/>
 <SolidColorBrush x:Key="AccentSoft" Color="#252A5C"/>
 <SolidColorBrush x:Key="AccentInk" Color="#C7D2FE"/>
 <SolidColorBrush x:Key="AccentLine" Color="#6366F1"/>
 <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
  <GradientStop Color="#5B5FEF" Offset="0"/>
  <GradientStop Color="#0891B2" Offset="1"/>
 </LinearGradientBrush>
 <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="0,1">
  <GradientStop Color="#0D0E26" Offset="0"/>
  <GradientStop Color="#080D1A" Offset="1"/>
 </LinearGradientBrush>
 <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
  <GradientStop Color="#1F2350" Offset="0"/>
  <GradientStop Color="#13283A" Offset="1"/>
 </LinearGradientBrush>
 <SolidColorBrush x:Key="DangerBrush" Color="#E5484D"/>
 <SolidColorBrush x:Key="DangerSoft" Color="#3A1D24"/>
 <SolidColorBrush x:Key="DangerInk" Color="#FDA4A8"/>
 <SolidColorBrush x:Key="DangerLine" Color="#6B2E38"/>
 <SolidColorBrush x:Key="Success" Color="#34D399"/>
 <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0,0" EndPoint="1,1">
  <GradientStop Color="#0E9F6E" Offset="0"/>
  <GradientStop Color="#0D9488" Offset="1"/>
 </LinearGradientBrush>
 <SolidColorBrush x:Key="SuccessSoft" Color="#123329"/>
 <SolidColorBrush x:Key="SuccessInk" Color="#6EE7B7"/>
 <SolidColorBrush x:Key="Warning" Color="#FBBF24"/>
 <SolidColorBrush x:Key="WarningSoft" Color="#382C12"/>
 <SolidColorBrush x:Key="WarningInk" Color="#FCD34D"/>
 <SolidColorBrush x:Key="WarningLine" Color="#5C4720"/>
 <SolidColorBrush x:Key="DisabledFill" Color="#23283F"/>
 <SolidColorBrush x:Key="DisabledInk" Color="#737B9B"/>
 <SolidColorBrush x:Key="Canvas" Color="#0E1120"/>
 <SolidColorBrush x:Key="Surface" Color="#161A2D"/>
 <SolidColorBrush x:Key="SurfaceAlt" Color="#1C2137"/>
 <SolidColorBrush x:Key="HoverFill" Color="#20264A"/>
 <SolidColorBrush x:Key="ChipFill" Color="#262C47"/>
 <SolidColorBrush x:Key="TrackFill" Color="#2A3050"/>
 <SolidColorBrush x:Key="GridLine" Color="#232943"/>
 <SolidColorBrush x:Key="Line" Color="#2A3050"/>
 <SolidColorBrush x:Key="LineStrong" Color="#454E75"/>
 <SolidColorBrush x:Key="PressOverlay" Color="#FFFFFF"/>
 <SolidColorBrush x:Key="Ink" Color="#ECEFFA"/>
 <SolidColorBrush x:Key="InkSoft" Color="#B3BAD3"/>
 <SolidColorBrush x:Key="InkMuted" Color="#959DBA"/>
</ResourceDictionary>
