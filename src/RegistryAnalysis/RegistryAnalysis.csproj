<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>FFCleaner.RegistryAnalysis</RootNamespace>
    <AssemblyName>FFCleaner.RegistryAnalysis</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FFCleaner.RegistryTests" />
    <InternalsVisibleTo Include="FFCleaner.RegistrySafetyTests" />
  </ItemGroup>

</Project>
